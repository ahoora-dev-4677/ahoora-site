import tkinter as tk
from tkinter import messagebox

root = tk.Tk()
root.title("لیست کارها")
root.geometry("400x500")

edit_index = None


def add_task():
    task = task_entry.get().strip()
    priority = priority_entry.get().strip()
    if task != "" and priority != "":
        task_list.insert(tk.END, task + " -- " + priority)
        task_entry.delete(0, tk.END)
        priority_entry.delete(0, tk.END)
    else:
        messagebox.showwarning("هشدار", "لطفاً هر دو فیلد را پر کنید!")


def delete_task():
    selected = task_list.curselection()
    if selected:
        task_list.delete(selected[0])
    else:
        messagebox.showwarning("هشدار", "لطفاً یک کار را انتخاب کنید!")


def mark_done():
    selected = task_list.curselection()
    if selected:
        task_list.itemconfig(selected[0], fg="gray")
    else:
        messagebox.showwarning("هشدار", "لطفاً یک کار را انتخاب کنید!")


def edit_task():
    global edit_index
    selected = task_list.curselection()
    if selected:
        edit_index = selected[0]
        task = task_list.get(edit_index)
        task_part, priority_part = task.split(" -- ")

        task_entry.delete(0, tk.END)
        priority_entry.delete(0, tk.END)

        task_entry.insert(0, task_part)
        priority_entry.insert(0, priority_part)
    else:
        messagebox.showwarning("هشدار", "لطفاً یک کار را برای ویرایش انتخاب کنید!")


def save_edit():
    global edit_index
    if edit_index is not None:
        task = task_entry.get().strip()
        priority = priority_entry.get().strip()
        if task != "" and priority != "":
            task_list.delete(edit_index)
            task_list.insert(edit_index, task + " -- " + priority)
            edit_index = None
            task_entry.delete(0, tk.END)
            priority_entry.delete(0, tk.END)
        else:
            messagebox.showwarning("هشدار", "فیلدها نمی‌توانند خالی باشند!")


def search_task():
    search_name = task_entry.get().strip()
    task_list.selection_clear(0, tk.END)
    if search_name == "":
        messagebox.showwarning("هشدار", "متن جستجو را وارد کنید!")
        return
    found = False
    for i in range(task_list.size()):
        item = task_list.get(i)
        if search_name.lower() in item.lower():
            task_list.selection_set(i)
            found = True
    if not found:
        messagebox.showinfo("نتیجه", "چیزی پیدا نشد!")


label = tk.Label(root, text="لیست کارها")
label.pack(pady=5)

task_entry = tk.Entry(root, width=30)
task_entry.pack(pady=5)

priority_entry = tk.Entry(root, width=30)
priority_entry.pack(pady=5)

add_button = tk.Button(root, text="افزودن", command=add_task)
add_button.pack(pady=5)

edit_button = tk.Button(root, text="ویرایش", command=edit_task)
edit_button.pack(pady=5)

save_button = tk.Button(root, text="ذخیره", command=save_edit)
save_button.pack(pady=5)

delete_button = tk.Button(root, text="حذف", command=delete_task)
delete_button.pack(pady=5)

done_button = tk.Button(root, text="انجام شد", command=mark_done)
done_button.pack(pady=5)

search_button = tk.Button(root, text="جستجو", command=search_task)
search_button.pack(pady=5)

task_list = tk.Listbox(
    root,
    width=40,
    height=15,
    selectmode=tk.SINGLE
)
task_list.pack(pady=5, padx=10, fill=tk.X)

root.mainloop()
